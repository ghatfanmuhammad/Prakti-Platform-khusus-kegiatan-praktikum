rules_version = '2';

// Firestore Security Rules PRAKTI (SRS-007)
// Prinsip: tolak semua kecuali yang diizinkan eksplisit sesuai identitas (UID) dan peran.
// Koleksi baru (kelas, sesi, presensi, ...) WAJIB ditambahkan aturannya di sini,
// kalau tidak, aksesnya otomatis ditolak.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() {
      return request.auth != null;
    }

    function profilPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function punyaProfil() {
      return signedIn() && exists(profilPath());
    }

    function peran() {
      return get(profilPath()).data.role;
    }

    function isAsisten() {
      return punyaProfil() && peran() == 'asisten';
    }

    function isPraktikan() {
      return punyaProfil() && peran() == 'praktikan';
    }

    // Email asisten resmi didaftarkan koordinator lewat Firebase Console
    // sebagai dokumen asisten_terdaftar/{email-huruf-kecil}.
    function emailAsistenTerdaftar() {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/asisten_terdaftar/$(request.auth.token.email.lower()));
    }

    // ---------- users/{uid}: profil & peran ----------
    match /users/{uid} {
      // Pemilik membaca profilnya sendiri; asisten boleh melihat profil (mis. data praktikan)
      allow read: if signedIn() && (request.auth.uid == uid || isAsisten());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'nimOrCode', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.nimOrCode is string && request.resource.data.nimOrCode.size() > 0
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role == 'praktikan'
            || (request.resource.data.role == 'asisten' && emailAsistenTerdaftar()));

      // Peran, email, dan uid tidak boleh diubah dari aplikasi
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nimOrCode']);

      allow delete: if false;
    }

    // ---------- asisten_terdaftar/{email}: daftar putih asisten ----------
    // Hanya dikelola lewat Firebase Console / Admin SDK.
    match /asisten_terdaftar/{email} {
      allow read, write: if false;
    }

    // ---------- Data praktikum (SRS-008) ----------
    function kelasPath(kelas) {
      return /databases/$(database)/documents/classes/$(kelas);
    }

    function jadwalPath(kelas, jadwal) {
      return /databases/$(database)/documents/classes/$(kelas)/schedules/$(jadwal);
    }

    function sesiPath(kelas, sesi) {
      return /databases/$(database)/documents/classes/$(kelas)/sessions/$(sesi);
    }

    function pesertaPath(id) {
      return /databases/$(database)/documents/participants/$(id);
    }

    function kodePath(kelas, sesi) {
      let id = kelas + '~' + sesi;
      return /databases/$(database)/documents/sessionCodes/$(id);
    }

    function anggota(kelas) {
      let id = kelas + '~' + request.auth.uid;
      return isPraktikan() && exists(pesertaPath(id))
        && get(pesertaPath(id)).data.classId == kelas
        && get(pesertaPath(id)).data.uid == request.auth.uid;
    }

    function bolehBacaKelas(kelas) {
      return isAsisten() || anggota(kelas);
    }

    function idValid(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function teksValid(value, size) {
      return value is string && value.trim().size() > 0 && value.size() <= size;
    }

    function jumlahValid(value) {
      return value is int && value >= 0;
    }

    function waktuTulisValid(d) {
      return d.createdAt is timestamp && d.updatedAt == request.time;
    }

    function kelasValid(d) {
      return d.keys().hasOnly([
          'kode', 'namaPraktikum', 'participantCount', 'scheduleCount', 'sessionCount',
          'createdAt', 'updatedAt', 'lastChildId'])
        && teksValid(d.kode, 40) && teksValid(d.namaPraktikum, 120)
        && jumlahValid(d.participantCount) && jumlahValid(d.scheduleCount)
        && jumlahValid(d.sessionCount) && waktuTulisValid(d);
    }

    // Parent counters are tied to exactly one child in the same atomic write.
    function pindahJumlah(sebelum, sesudah, path) {
      return (sesudah == sebelum + 1 && !exists(path) && existsAfter(path))
        || (sesudah == sebelum - 1 && exists(path) && !existsAfter(path));
    }

    function perubahanAnak(field, path) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([field, 'lastChildId', 'updatedAt'])
        && pindahJumlah(resource.data[field], d[field], path);
    }

    function perubahanKelasValid(kelas) {
      let d = request.resource.data;
      let perubahan = d.diff(resource.data).affectedKeys();
      return perubahan.hasOnly(['kode', 'namaPraktikum', 'updatedAt'])
        || (idValid(d.get('lastChildId', '')) &&
            (perubahanAnak('scheduleCount', jadwalPath(kelas, d.lastChildId))
              || perubahanAnak('sessionCount', sesiPath(kelas, d.lastChildId))))
        || (d.get('lastChildId', '') is string && d.lastChildId.matches('^[A-Za-z0-9_-]{1,128}~[A-Za-z0-9_-]{1,128}$')
            && d.lastChildId.split('~')[0] == kelas
            && perubahanAnak('participantCount', pesertaPath(d.lastChildId)));
    }

    function jumlahKelasBerubah(kelas, field, id, delta) {
      let path = kelasPath(kelas);
      let after = getAfter(path).data;
      return after.lastChildId == id && after[field] == get(path).data[field] + delta;
    }

    function menit(value) {
      return int(value.split(':')[0]) * 60 + int(value.split(':')[1]);
    }

    function jadwalValid(d) {
      return d.keys().hasOnly([
          'hari', 'mulai', 'selesai', 'ruangan', 'labId', 'sessionCount', 'createdAt', 'updatedAt', 'lastSessionId'])
        && d.hari in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu']
        && d.mulai is string && d.mulai.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.selesai is string && d.selesai.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && menit(d.mulai) < menit(d.selesai) && teksValid(d.ruangan, 120)
        && (!('labId' in d) || d.labId == null || idValid(d.labId))
        && jumlahValid(d.sessionCount) && waktuTulisValid(d);
    }

    function sesiDiJadwal(path, jadwal, setelah) {
      return setelah
        ? existsAfter(path) && getAfter(path).data.scheduleId == jadwal
        : exists(path) && get(path).data.scheduleId == jadwal;
    }

    function perubahanJadwalValid(kelas, jadwal) {
      let d = request.resource.data;
      let before = resource.data;
      let diff = d.diff(before).affectedKeys();
      return (diff.hasOnly(['hari', 'mulai', 'selesai', 'ruangan', 'labId', 'updatedAt'])
          && (before.sessionCount == 0 || !diff.hasAny(['hari', 'mulai', 'selesai'])))
        || (diff.hasOnly(['sessionCount', 'lastSessionId', 'updatedAt'])
          && idValid(d.lastSessionId)
          && perubahanJumlahSesi(sesiPath(kelas, d.lastSessionId), jadwal, before.sessionCount, d.sessionCount));
    }

    function perubahanJumlahSesi(path, jadwal, sebelum, sesudah) {
      return (sesudah == sebelum + 1 && !sesiDiJadwal(path, jadwal, false) && sesiDiJadwal(path, jadwal, true))
        || (sesudah == sebelum - 1 && sesiDiJadwal(path, jadwal, false) && !sesiDiJadwal(path, jadwal, true));
    }

    function jumlahJadwalBerubah(kelas, jadwal, sesi, delta) {
      let path = jadwalPath(kelas, jadwal);
      let after = getAfter(path).data;
      return after.lastSessionId == sesi && after.sessionCount == get(path).data.sessionCount + delta;
    }

    function sesiValid(d, kelas) {
      return d.keys().hasOnly([
          'scheduleId', 'tanggal', 'modul', 'keterangan', 'status', 'asistenId', 'topik', 'createdAt', 'updatedAt'])
        && idValid(d.scheduleId) && existsAfter(jadwalPath(kelas, d.scheduleId))
        && d.tanggal is string && d.tanggal.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && teksValid(d.modul, 160) && d.keterangan is string && d.keterangan.size() <= 1000
        && d.status in ['belum_dibuka', 'dibuka', 'ditutup']
        && (d.topik == null || teksValid(d.topik, 80))
        && waktuTulisValid(d);
    }

    function ubahRencanaSesi(kelas, sesi) {
      let d = request.resource.data;
      let before = resource.data;
      return before.status == 'belum_dibuka' && d.status == 'belum_dibuka'
        && d.diff(before).affectedKeys().hasOnly(['scheduleId', 'tanggal', 'modul', 'keterangan', 'updatedAt'])
        && (d.scheduleId == before.scheduleId
          || (jumlahJadwalBerubah(kelas, d.scheduleId, sesi, 1)
            && jumlahJadwalBerubah(kelas, before.scheduleId, sesi, -1)));
    }

    function ubahStatusSesi(kelas, sesi) {
      let d = request.resource.data;
      let before = resource.data;
      let diff = d.diff(before).affectedKeys();
      return before.asistenId == request.auth.uid
        && ((before.status == 'belum_dibuka' && d.status == 'dibuka'
            && diff.hasOnly(['status', 'topik', 'updatedAt'])
            && getAfter(kodePath(kelas, sesi)).data.classId == kelas)
          || (before.status == 'dibuka' && d.status == 'ditutup'
            && diff.hasOnly(['status', 'updatedAt']) && !existsAfter(kodePath(kelas, sesi))));
    }

    match /classes/{kelas} {
      allow get: if bolehBacaKelas(kelas);
      allow list: if isAsisten();
      allow create: if isAsisten() && idValid(kelas) && kelasValid(request.resource.data)
        && !('lastChildId' in request.resource.data) && request.resource.data.createdAt == request.time
        && request.resource.data.participantCount == 0 && request.resource.data.scheduleCount == 0
        && request.resource.data.sessionCount == 0;
      allow update: if isAsisten() && kelasValid(request.resource.data) && perubahanKelasValid(kelas);
      allow delete: if isAsisten() && resource.data.participantCount == 0
        && resource.data.scheduleCount == 0 && resource.data.sessionCount == 0;

      match /schedules/{jadwal} {
        allow read: if exists(kelasPath(kelas)) && bolehBacaKelas(kelas);
        allow create: if isAsisten() && idValid(jadwal) && jadwalValid(request.resource.data)
          && !('lastSessionId' in request.resource.data)
          && request.resource.data.createdAt == request.time && request.resource.data.sessionCount == 0
          && jumlahKelasBerubah(kelas, 'scheduleCount', jadwal, 1);
        allow update: if isAsisten() && existsAfter(kelasPath(kelas))
          && jadwalValid(request.resource.data) && perubahanJadwalValid(kelas, jadwal);
        allow delete: if isAsisten() && resource.data.sessionCount == 0
          && jumlahKelasBerubah(kelas, 'scheduleCount', jadwal, -1);
      }

      match /sessions/{sesi} {
        allow read: if exists(kelasPath(kelas)) && bolehBacaKelas(kelas);
        allow create: if isAsisten() && idValid(sesi) && sesiValid(request.resource.data, kelas)
          && request.resource.data.asistenId == request.auth.uid && request.resource.data.topik == null
          && request.resource.data.createdAt == request.time && request.resource.data.status == 'belum_dibuka'
          && jumlahKelasBerubah(kelas, 'sessionCount', sesi, 1)
          && jumlahJadwalBerubah(kelas, request.resource.data.scheduleId, sesi, 1);
        allow update: if isAsisten() && existsAfter(kelasPath(kelas))
          && sesiValid(request.resource.data, kelas) && (ubahRencanaSesi(kelas, sesi) || ubahStatusSesi(kelas, sesi));
        allow delete: if isAsisten() && resource.data.status == 'belum_dibuka'
          && jumlahKelasBerubah(kelas, 'sessionCount', sesi, -1)
          && jumlahJadwalBerubah(kelas, resource.data.scheduleId, sesi, -1);
      }
    }

    function pesertaValid(d, id) {
      return d.keys().hasOnly(['classId', 'uid', 'nama', 'nim', 'createdAt', 'updatedAt'])
        && idValid(d.classId) && idValid(d.uid) && id == d.classId + '~' + d.uid
        && teksValid(d.nama, 120) && teksValid(d.nim, 40) && waktuTulisValid(d)
        && get(/databases/$(database)/documents/users/$(d.uid)).data.role == 'praktikan';
    }

    match /participants/{id} {
      allow read: if isAsisten() || (isPraktikan() && resource.data.uid == request.auth.uid);
      allow create: if isAsisten() && pesertaValid(request.resource.data, id)
        && request.resource.data.createdAt == request.time
        && jumlahKelasBerubah(request.resource.data.classId, 'participantCount', id, 1);
      allow update: if isAsisten() && pesertaValid(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'nim', 'updatedAt']);
      allow delete: if isAsisten() && jumlahKelasBerubah(resource.data.classId, 'participantCount', id, -1);
    }

    // Compatibility with the existing QR check-in workflow.
    match /sessionCodes/{id} {
      allow read: if isAsisten();
      allow create: if isAsisten() && request.resource.data.keys().hasOnly(['classId', 'sesiId', 'kode'])
        && idValid(request.resource.data.sesiId) && idValid(request.resource.data.classId)
        && id == request.resource.data.classId + '~' + request.resource.data.sesiId
        && request.resource.data.kode is string && request.resource.data.kode.matches('^[0-9]{4}$')
        && get(sesiPath(request.resource.data.classId, request.resource.data.sesiId)).data.status == 'belum_dibuka'
        && getAfter(sesiPath(request.resource.data.classId, request.resource.data.sesiId)).data.status == 'dibuka'
        && getAfter(sesiPath(request.resource.data.classId, request.resource.data.sesiId)).data.asistenId == request.auth.uid;
      allow delete: if isAsisten()
        && getAfter(sesiPath(resource.data.classId, resource.data.sesiId)).data.status == 'ditutup'
        && getAfter(sesiPath(resource.data.classId, resource.data.sesiId)).data.asistenId == request.auth.uid;
    }

    function koordinatValid(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }

    // Rules menghitung jarak sendiri dari koordinat, tidak mempercayai flag/jarak klien.
    // Koordinat tetap dilaporkan perangkat; ini bukan perlindungan GPS spoofing.
    function lokasiHadirValid(lokasi, sesi, kelas) {
      let jadwal = get(jadwalPath(kelas, sesi.scheduleId)).data;
      let lab = get(/databases/$(database)/documents/laboratories/$(jadwal.labId)).data;
      return lokasi.keys().hasOnly(['labId', 'lat', 'lng', 'akurasi'])
        && lokasi.labId == jadwal.labId && koordinatValid(lokasi) && koordinatValid(lab)
        && lab.radiusMeter is number && lab.radiusMeter >= 1 && lab.radiusMeter <= 10000
        && (lokasi.akurasi == null || (lokasi.akurasi is number && lokasi.akurasi >= 0 && lokasi.akurasi <= 100))
        && latlng.value(lokasi.lat, lokasi.lng).distance(latlng.value(lab.lat, lab.lng)) <= lab.radiusMeter;
    }

    function catatanHadirValid(d, id) {
      let sesi = sesiPath(d.classId, d.sessionId);
      return d.keys().hasOnly(['classId', 'sessionId', 'sesiId', 'praktikanId', 'kode', 'waktuHadir', 'lokasi'])
        && idValid(d.classId) && idValid(d.sessionId)
        && d.praktikanId == request.auth.uid && d.sesiId == d.classId + '~' + d.sessionId
        && id == d.sesiId + '~' + request.auth.uid
        && anggota(d.classId) && d.waktuHadir == request.time
        && get(sesi).data.status == 'dibuka'
        && d.kode == get(kodePath(d.classId, d.sessionId)).data.kode
        && lokasiHadirValid(d.lokasi, get(sesi).data, d.classId);
    }

    match /attendance/{id} {
      allow get: if isAsisten() || (isPraktikan()
        && id.split('~').size() == 3 && id.split('~')[2] == request.auth.uid);
      allow list: if isAsisten() || (isPraktikan() && resource.data.praktikanId == request.auth.uid);
      allow create: if isPraktikan() && catatanHadirValid(request.resource.data, id);
    }

    // ---------- laboratories/{labId}: lokasi laboratorium (SRS-014) ----------
    match /laboratories/{labId} {
      allow read: if isAsisten() || isPraktikan();
      allow write: if isAsisten();
    }

    // ---------- izin/{izinId}: pengajuan izin (SRS-010) & pemeriksaan (SRS-011) ----------
    match /izin/{izinId} {
      // Field hasil klasifikasi AI (informasi pendukung; tidak memengaruhi status izin)
      function fieldAI() {
        return ['kategoriAI', 'confidenceAI', 'statusAI', 'pesanAI', 'diklasifikasiPada'];
      }

      function hasilAIValid(d) {
        return d.statusAI in ['berhasil', 'gagal']
          && (d.kategoriAI == null || (d.kategoriAI is string && d.kategoriAI.size() <= 100))
          && (d.confidenceAI == null
              || ((d.confidenceAI is number) && d.confidenceAI >= 0 && d.confidenceAI <= 1))
          && (d.pesanAI == null || (d.pesanAI is string && d.pesanAI.size() <= 200))
          && d.diklasifikasiPada == request.time
          // Berhasil wajib punya kategori; gagal tidak boleh punya kategori
          && ((d.statusAI == 'berhasil' && d.kategoriAI is string)
              || (d.statusAI == 'gagal' && d.kategoriAI == null));
      }

      // Asisten melihat semua; praktikan hanya izin miliknya
      allow read: if isAsisten()
        || (isPraktikan() && resource.data.praktikanId == request.auth.uid);

      // Praktikan mengajukan izin atas nama dirinya sendiri, status awal Menunggu
      allow create: if isPraktikan()
        && request.resource.data.keys().hasOnly([
             'praktikanId', 'praktikanNama', 'praktikanNim', 'sesiId', 'sesiNama',
             'alasan', 'status', 'createdAt', 'updatedAt'].concat(fieldAI()))
        && request.resource.data.keys().hasAll(fieldAI())
        && request.resource.data.praktikanId == request.auth.uid
        && request.resource.data.sesiId is string && request.resource.data.sesiId.size() > 0
        && request.resource.data.alasan is string
        && request.resource.data.alasan.trim().size() >= 10
        && request.resource.data.alasan.size() <= 500
        // AI tidak boleh menentukan keputusan: izin baru selalu Menunggu
        && request.resource.data.status == 'Menunggu'
        && hasilAIValid(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Asisten mengulang klasifikasi AI: hanya field AI yang boleh berubah
      allow update: if isAsisten()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fieldAI())
        && hasilAIValid(request.resource.data);

      // Hanya asisten yang memutuskan, hanya sekali (dari Menunggu), dan tercatat UID-nya
      allow update: if isAsisten()
        && resource.data.status == 'Menunggu'
        && request.resource.data.status in ['Disetujui', 'Ditolak']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedBy is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedByUid', 'updatedAt']);

      allow delete: if false;
    }
  }
}
