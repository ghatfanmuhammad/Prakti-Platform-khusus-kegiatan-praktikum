# Salin file ini menjadi .env.local lalu isi nilainya (.env.local tidak ikut ke git).
# Setelah mengubah, restart Metro: npx expo start -c

# Endpoint model AI klasifikasi alasan izin dari pengajar.
# Isi "mock" untuk mode uji coba (tebakan kata kunci, BUKAN AI) sebelum API tersedia.
EXPO_PUBLIC_AI_API_URL=mock

# Token API (kosongkan bila tidak diperlukan). Dikirim sebagai header "Authorization: Bearer <token>".
EXPO_PUBLIC_AI_API_KEY=
